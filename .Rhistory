for (f in c("_quarto.yml", "Week1-RSpatial.qmd", "index.qmd")) {
cat("---", f, "---\n")
x <- readLines(f, warn = FALSE)
print(grep("theme", x, value = TRUE))
}
for (f in list.files(pattern = "\\.qmd$")) {
x <- readLines(f, warn = FALSE)
hit <- grep("^format:|theme", x, value = TRUE)
if (length(hit)) { cat("---", f, "---\n"); print(hit) }
}
