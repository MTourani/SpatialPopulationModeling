project:
  type: website
  output-dir: docs
  render:
    - index.qmd
    - Week*.qmd
  resources:
    - images/
    - data/

website:
  title: "Spatial Population Modeling"
  description: ""
  navbar:
    left:
      - href: index.qmd
        text: "Week"

format:
  live-revealjs:
    theme: [default, wild541.scss]
    width: 1280
    height: 720
    margin: 0.1
    slide-number: true
    progress: true
    history: false
    chalkboard: false
    controls: true
    menu: true
    highlight-style: a11y
    code-block-bg: "#F0F4FF"
    code-block-border-left: "#2563EB"
    fig-align: center
    fig-width: 7
    fig-height: 4
    webr:
      packages: []
      cell-options:
        fig-width: 7
        fig-height: 4
        min-lines: 3
        max-lines: 14
        completion: true
        timelimit: 30
    live:
      show-solutions: true
      show-hints: true

engine: knitr

lang: en-US

execute:
  echo: true
  eval: false
  warning: false
  message: false
  cache: false
  freeze: auto